# WebSocket URL of the deployed microservice tunnel endpoint.
# Local dev example:  ws://localhost:3000/agent-tunnel
# Production example:  wss://your-tenant.cumulocity.com/service/local-ai-proxy/agent-tunnel
PROXY_WSS_URL=ws://localhost:3000/agent-tunnel

# Must match the microservice's tunnel secret (tenant option tunnel.secret in
# category local.ai, or the TUNNEL_SECRET env var in local dev).
TUNNEL_SECRET=dev-shared-secret-change-me

# Local LM Studio OpenAI-compatible server (Developer tab → Start Server).
LMSTUDIO_URL=http://127.0.0.1:1234

# Auth header for the Cumulocity gateway on the WS upgrade.
# REQUIRED in production (wss://<tenant>/service/...); leave unset for local dev.
# Build it from a user with access to the microservice:
#   printf '<user>:<password>' | base64
C8Y_AUTH=Basic <base64 of user:password>