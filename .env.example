# ── c8y-nitro dev bootstrap (development tenant) ────────────────────────────
C8Y_BASEURL=https://your-tenant.cumulocity.com
C8Y_DEVELOPMENT_TENANT=t12345
C8Y_DEVELOPMENT_USER=your-username
C8Y_DEVELOPMENT_PASSWORD=your-password

# ── Tunnel secret (local dev fallback) ──────────────────────────────────────
# In production this comes from the tenant option "tunnel.secret" (category
# "local.ai"). For `pnpm dev` (no bootstrapped tenant option yet) the
# microservice falls back to this env var. The Mac client must present the
# same value. Generate one with: openssl rand -hex 32
TUNNEL_SECRET=dev-shared-secret-change-me
